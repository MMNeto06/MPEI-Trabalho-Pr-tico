clc; clear; close all;

baseDir = fileparts(mfilename('fullpath'));
addpath(fullfile(baseDir, 'naive_bayes'));
addpath(fullfile(baseDir, 'bloom_filter'));
addpath(fullfile(baseDir, 'minhash'));

fprintf('TESTES DO MÓDULO MINHASH\n');

data = readtable(fullfile(baseDir, 'data', 'beijing.csv')); %podem trocar à vontade
data.date = [];
data.dew_point_mean = [];
data.dew_point_max = [];
data.temp_mean = (data.temp_max + data.temp_min) / 2;
data.season_temp = data.temp_mean .* data.month_cos;
data.cos_x_tmax = data.month_cos .* data.temp_max;

Y = categorical(data.weather);
X = table2array(removevars(data, 'weather'));

rng(42); %podem remover o 42 para resultados sempre aleatórios
idx = randperm(size(X, 1));
nTrain = round(0.8 * length(idx));
XTrain = X(idx(1:nTrain), :);
YTrain = Y(idx(1:nTrain));
XTest = X(idx(nTrain+1:end), :);
YTest = Y(idx(nTrain+1:end));

thresholds = compute_thresholds(XTrain, YTrain);

fprintf('Treino: %d amostras | Teste: %d amostras\n\n', size(XTrain,1), size(XTest,1));

%  Teste 1: Extração de Features (Tokens)
fprintf('Teste 1: Extração de Features (Tokenização)\n');
trainTokens = extract_features(XTrain, thresholds);
testTokens  = extract_features(XTest,  thresholds);

fprintf('Colunas de tokens por amostra : %d\n', size(trainTokens, 2));
fprintf('Dimensões tokens treino       : %d x %d\n', size(trainTokens));
fprintf('Dimensões tokens teste        : %d x %d\n', size(testTokens));

n_vazios = sum(strtrim(string(trainTokens)) == "");
if n_vazios == 0
    fprintf('PASSOU: Nenhum token vazio no conjunto de treino\n');
else
    fprintf('AVISO : %d tokens vazios no conjunto de treino\n', n_vazios);
end

fprintf('Tokens únicos nas primeiras 4 colunas de feature:\n');
colNames = {'precip', 'humidity', 'cloud', 'precip_hours'};
for col = 1:4
    uq = unique(trainTokens(:, col));
    fprintf('  %s: %s\n', colNames{col}, strjoin(uq, ' | '));
end
fprintf('\n');

%  Teste 2: Geração de Assinaturas MinHash — Dimensões e Validade
fprintf('Teste 2: Geração de Assinaturas MinHash\n');
nHash = 200;
[sigTrain, hashData] = minhash_signature(trainTokens, nHash);
sigTest = minhash_signature(testTokens, hashData);

fprintf('nHash usado              : %d\n', nHash);
fprintf('Dimensões sigTrain       : %d x %d  (nHash x nTreino)\n', size(sigTrain));
fprintf('Dimensões sigTest        : %d x %d  (nHash x nTeste)\n',  size(sigTest));

if size(sigTrain, 1) == nHash
    fprintf('PASSOU (2a): Número de linhas da assinatura = nHash\n');
else
    fprintf('FALHOU (2a): Esperado %d linhas, obtido %d\n', nHash, size(sigTrain,1));
end
if size(sigTrain, 2) == size(XTrain, 1)
    fprintf('PASSOU (2b): Número de colunas = nTrain\n\n');
else
    fprintf('FALHOU (2b): Esperado %d colunas, obtido %d\n', size(XTrain,1), size(sigTrain,2));
end


%  Teste 3: Documentos Idênticos têm Similaridade 1.0
fprintf('--- Teste 3: Similaridade de Documentos Idênticos (deve ser 1.0) ---\n');
amostra_idx = 1:min(10, size(trainTokens,1));
[sig_a, hd] = minhash_signature(trainTokens(amostra_idx, :), nHash);
sig_b = minhash_signature(trainTokens(amostra_idx, :), hd);

self_sims = mean(sig_a == sig_b, 1);
fprintf('Similaridades de documentos idênticos:\n  ');
fprintf('%.4f ', self_sims);
fprintf('\n');
if all(self_sims >= 0.999)
    fprintf('PASSOU: Todas as similaridades de documentos idênticos >= 0.999\n\n');
else
    n_falhou = sum(self_sims < 0.999);
    fprintf('FALHOU: %d documento(s) com similaridade < 0.999\n\n', n_falhou);
end

%  Teste 4: Similaridade Intra-Classe vs Inter-Classe
fprintf('--- Teste 4: Similaridade Intra-Classe vs Inter-Classe ---\n');
fprintf('Espera-se: Sim. Intra > Sim. Inter para cada classe\n\n');
classes = unique(YTrain);
nClasses = numel(classes);
nHash_used = size(sigTrain, 1);

% Usar subset para eficiência
nSample = min(40, size(sigTest, 2));
sample_i = randperm(size(sigTest, 2), nSample);

fprintf('  %-12s  %-14s  %-14s  %-8s\n', 'Classe', 'Sim. Intra (Top5)', 'Sim. Inter (Top5)', 'OK?');
fprintf('  %s\n', repmat('-', 1, 55));

all_ok = true;
for c = 1:nClasses
    cls = classes(c);
    cls_test_i = find(YTest(sample_i) == cls);
    cls_train_i = find(YTrain == cls);
    other_train_i = find(YTrain ~= cls);

    if numel(cls_test_i) < 2 || isempty(cls_train_i), continue; end

    k_top = min(5, numel(cls_train_i));
    sims_intra = zeros(numel(cls_test_i), 1);
    for i = 1:numel(cls_test_i)
        t = sample_i(cls_test_i(i));
        s = sum(sigTest(:,t) == sigTrain(:, cls_train_i), 1) / nHash_used;
        sims_intra(i) = mean(maxk(s, k_top));
    end

    k_top2 = min(5, numel(other_train_i));
    sims_inter = zeros(numel(cls_test_i), 1);
    for i = 1:numel(cls_test_i)
        t = sample_i(cls_test_i(i));
        s = sum(sigTest(:,t) == sigTrain(:, other_train_i), 1) / nHash_used;
        sims_inter(i) = mean(maxk(s, k_top2));
    end

    si = mean(sims_intra);
    se   = mean(sims_inter);
    ok   = si > se;
    all_ok = all_ok && ok;
    fprintf('  %-12s  %-14.4f  %-14.4f  %s\n', char(cls), si, se, ternary(ok,'PASSOU','FALHOU'));
end
if all_ok
    fprintf('\n  PASSOU: Intra > Inter para todas as classes com amostras suficientes\n\n');
else
    fprintf('\n  AVISO : Algumas classes não mostram Intra > Inter (pode indicar classes difíceis de separar)\n\n');
end

%% ----------------------------------------------------------------
%  Teste 5: Efeito do Número de Hash Functions
%  (estabilidade da estimativa de Jaccard vs custo computacional)
%% ----------------------------------------------------------------
fprintf('--- Teste 5: Efeito do Número de Hash Functions na Qualidade ---\n');
fprintf('  %-8s  %-22s  %-18s  %-12s\n', 'nHash', 'Sim. Intra média', 'Sim. Inter média', 'Tempo (s)');
fprintf('  %s\n', repmat('-', 1, 66));

nHash_vals = [25, 50, 100, 200, 400];
sub_train  = trainTokens(1:min(150, size(trainTokens,1)), :);
sub_test   = testTokens(1:min(30,  size(testTokens,1)),  :);
sub_Ytrain = YTrain(1:size(sub_train,1));
sub_Ytest  = YTest(1:size(sub_test,1));

for nh = nHash_vals
    t0 = tic;
    [sig_tr, hd_tmp] = minhash_signature(sub_train, nh);
    sig_te           = minhash_signature(sub_test,  hd_tmp);
    elapsed          = toc(t0);

    % Calcular similaridade intra vs inter usando primeira classe disponível
    cls1        = unique(sub_Ytrain);
    cls1        = cls1(1);
    idx_cls_tr  = find(sub_Ytrain == cls1);
    idx_oth_tr  = find(sub_Ytrain ~= cls1);
    idx_cls_te  = find(sub_Ytest  == cls1);

    if isempty(idx_cls_te) || isempty(idx_cls_tr)
        fprintf('  %-8d  %-22s  %-18s  %.4f\n', nh, 'N/A', 'N/A', elapsed);
        continue;
    end

    s_intra = mean(mean(sig_te(:, idx_cls_te) == sig_tr(:, idx_cls_tr(1)), 1));
    s_inter = mean(mean(sig_te(:, idx_cls_te) == sig_tr(:, idx_oth_tr(1)),  1));
    fprintf('  %-8d  %-22.4f  %-18.4f  %.4f\n', nh, s_intra, s_inter, elapsed);
end
fprintf('\n');

%% ----------------------------------------------------------------
%  Teste 6: Top-K por Classe — Consistência com o Ensemble
%  (replica o bloco 5 de ensemble_predict.m fora do ensemble)
%% ----------------------------------------------------------------
fprintf('--- Teste 6: Top-20 Similaridade por Classe (como no Ensemble) ---\n');
nTeste    = size(XTest, 1);
p_mh      = zeros(nTeste, nClasses);

allSims   = zeros(nTeste, size(XTrain,1));
sigTrain_i = int32(sigTrain);
sigTest_i  = int32(sigTest);
for kh = 1:nHash_used
    allSims = allSims + (sigTest_i(kh, :).' == sigTrain_i(kh, :));
end
allSims = allSims / nHash_used;

classIdx    = cell(nClasses, 1);
classCounts = zeros(nClasses, 1);
for c = 1:nClasses
    classIdx{c}    = find(YTrain == classes(c));
    classCounts(c) = numel(classIdx{c});
end

for c = 1:nClasses
    k_eff        = min(20, classCounts(c));
    topK         = maxk(allSims(:, classIdx{c}), k_eff, 2);
    p_mh(:, c)   = mean(topK, 2);
end
p_mh = p_mh ./ (sum(p_mh, 2) + 1e-9);

[~, best_mh]  = max(p_mh, [], 2);
pred_mh       = categorical(string(classes(best_mh)));
acc_mh        = mean(pred_mh == YTest);
fprintf('Exatidão do MinHash (Top-20, standalone): %.4f (%.2f%%)\n', acc_mh, acc_mh*100);
fprintf('(Valor esperado: inferior ao Ensemble mas superior a acerto aleatório)\n\n');

fprintf('============================================================\n');
fprintf('            TESTES DO MINHASH CONCLUÍDOS                   \n');
fprintf('============================================================\n');

%% --- Função auxiliar ---
function s = ternary(cond, a, b)
    if cond, s = a; else, s = b; end
end